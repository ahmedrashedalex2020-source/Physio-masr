{
  "entities": {
    "SessionRecord": {
      "title": "SessionRecord",
      "description": "A physiotherapy clinic session record synchronized across desktop and mobile devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session identifier" },
        "clientName": { "type": "string", "description": "Full name of the patient" },
        "clientPhone": { "type": "string", "description": "Phone number of the patient" },
        "condition": { "type": "string", "description": "Medical condition or diagnosis" },
        "notes": { "type": "string", "description": "Clinical or payment notes" },
        "attendanceDate": { "type": "string", "description": "Session date in YYYY-MM-DD format" },
        "attendanceTime": { "type": "string", "description": "Session time in HH:mm format" },
        "basePrice": { "type": "number", "description": "Base session price in EGP" },
        "totalPrice": { "type": "number", "description": "Total session price in EGP" },
        "priceDetails": { "type": "string", "description": "Text breakdown of the price" },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid", "cancelled"],
          "description": "Payment status of the session"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "bank_transfer", "credit_card"],
          "description": "Method of payment"
        },
        "createdAt": { "type": "string", "description": "ISO timestamp when record was created" },
        "archiveId": { "type": "string", "description": "Optional ID of the closed monthly archive this session belongs to" },
        "archiveLabel": { "type": "string", "description": "Optional display title of the closed monthly archive" }
      },
      "required": [
        "id",
        "clientName",
        "clientPhone",
        "condition",
        "attendanceDate",
        "attendanceTime",
        "basePrice",
        "totalPrice",
        "priceDetails",
        "paymentStatus",
        "paymentMethod",
        "createdAt"
      ]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "A registered physiotherapy patient profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique client identifier" },
        "name": { "type": "string", "description": "Full name of the patient" },
        "phone": { "type": "string", "description": "Phone number of the patient" },
        "primaryCondition": { "type": "string", "description": "Primary medical condition" },
        "notes": { "type": "string", "description": "Additional medical notes" },
        "firstVisitDate": { "type": "string", "description": "Date of first visit YYYY-MM-DD" },
        "lastVisitDate": { "type": "string", "description": "Date of most recent visit YYYY-MM-DD" }
      },
      "required": [
        "id",
        "name",
        "phone",
        "primaryCondition",
        "firstVisitDate",
        "lastVisitDate"
      ]
    },
    "MonthlyArchive": {
      "title": "MonthlyArchive",
      "description": "A closed and archived monthly financial & session summary record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique archive identifier" },
        "title": { "type": "string", "description": "Display title of the closed month (e.g. حساب شهر أكتوبر 2026)" },
        "closedAt": { "type": "string", "description": "ISO timestamp when the month was closed and archived" },
        "startDate": { "type": "string", "description": "Earliest session date in this archived period" },
        "endDate": { "type": "string", "description": "Latest session date in this archived period" },
        "totalSessions": { "type": "number", "description": "Total number of sessions archived in this period" },
        "totalRevenue": { "type": "number", "description": "Total revenue in EGP for this archived period" },
        "paidRevenue": { "type": "number", "description": "Total collected/paid amount in EGP" },
        "pendingRevenue": { "type": "number", "description": "Total pending/unpaid amount in EGP" },
        "paidCount": { "type": "number", "description": "Count of paid sessions" },
        "pendingCount": { "type": "number", "description": "Count of pending sessions" },
        "notes": { "type": "string", "description": "Optional closing notes" }
      },
      "required": [
        "id",
        "title",
        "closedAt",
        "startDate",
        "endDate",
        "totalSessions",
        "totalRevenue",
        "paidRevenue",
        "pendingRevenue",
        "paidCount",
        "pendingCount"
      ]
    },
    "ClinicSyncMeta": {
      "title": "ClinicSyncMeta",
      "description": "Metadata document tracking initial seeding status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seeded": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "totalSessions": { "type": "number" }
      },
      "required": ["id", "seeded", "updatedAt"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SessionRecord" },
      "description": "Collection of all physiotherapy clinic sessions"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientProfile" },
      "description": "Collection of all registered clinic patients"
    },
    "/monthly_archives/{archiveId}": {
      "schema": { "$ref": "#/entities/MonthlyArchive" },
      "description": "Collection of closed and archived monthly financial & session summaries"
    },
    "/sync_meta/{metaId}": {
      "schema": { "$ref": "#/entities/ClinicSyncMeta" },
      "description": "Collection storing clinic database seeding and sync metadata"
    }
  }
}
