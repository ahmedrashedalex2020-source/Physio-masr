rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isClinicRequest() {
      return request.time != null;
    }

    function isValidSession(data) {
      return data.keys().hasAll([
        'id',
        'clientName',
        'clientPhone',
        'condition',
        'attendanceDate',
        'attendanceTime',
        'basePrice',
        'totalPrice',
        'priceDetails',
        'paymentStatus',
        'paymentMethod',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'clientName',
        'clientPhone',
        'condition',
        'notes',
        'attendanceDate',
        'attendanceTime',
        'basePrice',
        'totalPrice',
        'priceDetails',
        'paymentStatus',
        'paymentMethod',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 200 &&
      data.clientPhone is string && data.clientPhone.size() >= 1 && data.clientPhone.size() <= 50 &&
      data.condition is string && data.condition.size() >= 1 && data.condition.size() <= 300 &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
      data.attendanceDate is string && data.attendanceDate.size() >= 1 && data.attendanceDate.size() <= 20 &&
      data.attendanceTime is string && data.attendanceTime.size() >= 1 && data.attendanceTime.size() <= 20 &&
      data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 1000000 &&
      data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 1000000 &&
      data.priceDetails is string && data.priceDetails.size() <= 200 &&
      data.paymentStatus is string && data.paymentStatus in ['pending', 'paid', 'cancelled'] &&
      data.paymentMethod is string && data.paymentMethod in ['cash', 'bank_transfer', 'credit_card'] &&
      data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64;
    }

    function isValidClient(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'phone',
        'primaryCondition',
        'firstVisitDate',
        'lastVisitDate'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'phone',
        'primaryCondition',
        'notes',
        'firstVisitDate',
        'lastVisitDate'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 50 &&
      data.primaryCondition is string && data.primaryCondition.size() >= 1 && data.primaryCondition.size() <= 300 &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
      data.firstVisitDate is string && data.firstVisitDate.size() >= 1 && data.firstVisitDate.size() <= 20 &&
      data.lastVisitDate is string && data.lastVisitDate.size() >= 1 && data.lastVisitDate.size() <= 20;
    }

    function isValidSyncMeta(data) {
      return data.keys().hasAll(['id', 'seeded', 'updatedAt', 'totalSessions']) &&
      data.keys().hasOnly(['id', 'seeded', 'updatedAt', 'totalSessions']) &&
      isValidId(data.id) &&
      data.seeded is bool &&
      data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64 &&
      data.totalSessions is number && data.totalSessions >= 0 && data.totalSessions <= 100000;
    }

    // Sessions Collection Rules
    match /sessions/{sessionId} {
      allow get: if isClinicRequest() && isValidId(sessionId);
      allow list: if isClinicRequest();
      allow create: if isClinicRequest() &&
        isValidId(sessionId) &&
        isValidSession(incoming()) &&
        incoming().id == sessionId;
      allow update: if isClinicRequest() &&
        isValidId(sessionId) &&
        isValidSession(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Toggle Payment Status
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus']) ||
          // Action 2: Edit Session Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'clientName',
            'clientPhone',
            'condition',
            'notes',
            'attendanceDate',
            'attendanceTime',
            'basePrice',
            'totalPrice',
            'priceDetails',
            'paymentStatus',
            'paymentMethod'
          ])
        );
      allow delete: if isClinicRequest() && isValidId(sessionId);
    }

    // Clients Collection Rules
    match /clients/{clientId} {
      allow get: if isClinicRequest() && isValidId(clientId);
      allow list: if isClinicRequest();
      allow create: if isClinicRequest() &&
        isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().id == clientId;
      allow update: if isClinicRequest() &&
        isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'phone',
          'primaryCondition',
          'notes',
          'firstVisitDate',
          'lastVisitDate'
        ]);
      allow delete: if isClinicRequest() && isValidId(clientId);
    }

    // Sync Metadata Collection Rules
    match /sync_meta/{metaId} {
      allow get: if isClinicRequest() && isValidId(metaId);
      allow list: if isClinicRequest();
      allow create: if isClinicRequest() &&
        isValidId(metaId) &&
        isValidSyncMeta(incoming()) &&
        incoming().id == metaId;
      allow update: if isClinicRequest() &&
        isValidId(metaId) &&
        isValidSyncMeta(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'seeded',
          'updatedAt',
          'totalSessions'
        ]);
      allow delete: if isClinicRequest() && isValidId(metaId);
    }

    // Connection Test Endpoint
    match /test/{testId} {
      allow get: if isClinicRequest() && isValidId(testId);
    }
  }
}
